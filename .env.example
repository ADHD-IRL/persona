# Copy to .env. Keep .env out of Git.
# Use a password with URL-safe characters, or URL-encode it in DATABASE_URL.
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgresql://agentdebate:change-this-local-password@127.0.0.1:5432/agentdebate
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false

# Optional read-only MCP integration (server configuration only).
# MCP_WORKSPACE_ID=<local-workspace-uuid>
# MCP_API_KEYS=<sha256-hash:label>

# AI provider is selected by the server. Use anthropic to retain the existing provider.
LLM_PROVIDER=mitre_aip
MITRE_AIP_BASE_URL=https://models.k8s.aip.mitre.org/v1
MITRE_AIP_API_KEY=
# Choose an accessible model using Settings. Set a default here if desired.
MITRE_AIP_MODEL=
# Enable only after confirming tool support for the models you will select.
MITRE_AIP_SUPPORTS_TOOLS=false
MITRE_AIP_TOKEN_LIMIT_FIELD=max_tokens
MITRE_AIP_STREAM_USAGE=true
LLM_MAX_TOKENS=8192
# If Node needs your corporate CA, set its PEM bundle before starting Node.
# NODE_EXTRA_CA_CERTS=C:/path/to/mitre-ca.pem
